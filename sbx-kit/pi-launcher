#!/bin/sh

# Skip sandbox display clipboard tools; the host terminal receives OSC 52.
unset DISPLAY WAYLAND_DISPLAY
export PI_CLIPBOARD_OSC52=1

# Pi must start before project tools are installed; never enter a mise shim here.
exec /opt/pissbox/mise/installs/node/26.9.0/bin/node /opt/pissbox/npm/bin/pi "$@"
