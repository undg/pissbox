#!/usr/bin/env python3

import json
import os
import sys
import time

args = sys.argv[1:]
if os.environ.get("TEST_SBX_CALL_LOG"):
    with open(os.environ["TEST_SBX_CALL_LOG"], "a") as log:
        log.write(json.dumps(args) + "\n")
else:
    print("sbx:" + json.dumps(args), flush=True)

# Check restoration at handoff: macOS can revoke the PTY after session exit.
if expected := os.environ.get("TEST_SBX_EXPECT_TERMIOS"):
    import termios

    actual = termios.tcgetattr(sys.stdin.fileno())
    actual[6] = [value if isinstance(value, int) else value[0] for value in actual[6]]
    expected = json.loads(expected)
    if sys.platform == "darwin":
        # The kernel can set PENDIN when restoring canonical mode. It is
        # pending-input bookkeeping, not a setting the launcher failed to restore.
        actual[3] &= ~termios.PENDIN
        expected[3] &= ~termios.PENDIN
    fields = ("iflag", "oflag", "cflag", "lflag", "ispeed", "ospeed", "cc")
    differences = [f"{name}: expected {want!r}, got {got!r}"
                   for name, want, got in zip(fields, expected, actual) if want != got]
    if actual[3] != expected[3]:
        differences.append(f"lflag changed bits: {actual[3] ^ expected[3]:#x}")
    assert not differences, (
        f"terminal settings not restored before SBX handoff {args[:4]!r}: "
        + "; ".join(differences)
    )

if size := os.environ.get("TEST_SBX_TTY_OUTPUT_BYTES"):
    print("x" * int(size), flush=True)

if args[:1] == ["ls"]:
    if os.environ.get("TEST_SBX_LIST_STATUS"):
        print("error: listing unavailable", file=sys.stderr)
        sys.exit(int(os.environ["TEST_SBX_LIST_STATUS"]))
    print(os.environ.get("TEST_SBX_LISTING", "[]"))
    sys.exit(0)

if args[-1:] == ["pissbox-readiness"]:
    sys.exit(int(os.environ.get("TEST_SBX_READINESS_STATUS", "0")))

if os.environ.get("TEST_SBX_REQUIRE_TTY") == "1":
    assert sys.stdin.isatty(), "stdin is no longer a terminal"
    assert sys.stdout.isatty(), "stdout is no longer a terminal"

if args[:2] == ["run", "--name"]:
    sys.exit(int(os.environ.get("TEST_SBX_ATTACH_STATUS", "0")))
if args[:1] == ["exec"]:
    sys.exit(int(os.environ.get("TEST_SBX_EXEC_STATUS", "0")))
if args[:1] == ["rm"]:
    sys.exit(int(os.environ.get("TEST_SBX_REMOVE_STATUS", "0")))

mode = os.environ.get("TEST_SBX_MODE", "success")
if mode == "wait":
    time.sleep(60)
if mode == "conflict":
    name = os.environ.get("TEST_SBX_NAME", "pi-existing")
    print(
        f"error: sandbox '{name}' already exists and can't be given new workspaces",
        file=sys.stderr,
    )
    print(f"  try: sbx run --name {name}", file=sys.stderr)
    sys.exit(1)
if mode == "error":
    print("error: daemon unavailable", file=sys.stderr)
    sys.exit(7)

sys.exit(int(os.environ.get("TEST_SBX_RUN_STATUS", "0")))
