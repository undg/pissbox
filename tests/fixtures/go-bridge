#!/usr/bin/env python3

import argparse
import json
import os
from pathlib import Path
import signal
import sys

parser = argparse.ArgumentParser()
parser.add_argument("--mailbox", required=True)
parser.add_argument("--herdr-socket", required=True)
parser.add_argument("--herdr-pane", required=True)
args = parser.parse_args()
if os.environ.get("TEST_BRIDGE_START_FAIL") == "1":
    sys.exit(1)

log = Path(os.environ["TEST_BRIDGE_LOG"])
ready = Path(args.mailbox) / "ready"

def record(kind):
    with log.open("a") as output:
        output.write(json.dumps({"kind": kind, **vars(args)}) + "\n")

def stop(_signal, _frame):
    sys.exit(0)

signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
record("start")
ready.write_text("1\n")
try:
    while True:
        signal.pause()
finally:
    ready.unlink(missing_ok=True)
    record("stop")
