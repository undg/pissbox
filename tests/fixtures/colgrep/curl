#!/usr/bin/env python3

import json
import os
from pathlib import Path
import sys

args = sys.argv[1:]
url = args[-1]
with Path(os.environ["TEST_COLGREP_LOG"]).open("a") as log:
    log.write(json.dumps(args) + "\n")

failure = os.environ.get("TEST_COLGREP_FAIL_SUFFIX")
if failure and url.endswith(failure):
    print("fixture curl failure", file=sys.stderr)
    sys.exit(22)

if "--head" in args:
    print(
        os.environ.get(
            "TEST_COLGREP_RELEASE_URL",
            "https://github.com/lightonai/next-plaid/releases/tag/"
            + os.environ.get("TEST_COLGREP_VERSION", "v1.0.0"),
        ),
        end="",
    )
else:
    source = Path(os.environ["TEST_COLGREP_ASSETS"]) / url.rsplit("/", 1)[-1]
    destination = Path(args[args.index("--output") + 1])
    destination.write_bytes(source.read_bytes())
