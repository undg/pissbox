#!/usr/bin/env python3

# Test-only decompressor for GNU tar in the Linux sandbox, which has no xz.
# macOS tar handles XZ internally; Arch uses xz. The updater needs no Python.
import lzma
import shutil
import sys

with lzma.LZMAFile(sys.stdin.buffer) as source:
    shutil.copyfileobj(source, sys.stdout.buffer)
