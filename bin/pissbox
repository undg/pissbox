#!/usr/bin/env bash

set -euo pipefail

SCRIPT_PATH=${BASH_SOURCE[0]}
while [[ -L $SCRIPT_PATH ]]; do
	SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
	SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
	if [[ $SCRIPT_PATH != /* ]]; then
		SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
	fi
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd -P)"

case $(uname -s) in
Darwin) OS=darwin ;;
Linux) OS=linux ;;
*)
	echo "Unsupported launcher operating system. Supported: macOS and Linux." >&2
	exit 1
	;;
esac
case $(uname -m) in
arm64 | aarch64) ARCH=arm64 ;;
x86_64 | amd64) ARCH=amd64 ;;
*)
	echo "Unsupported launcher architecture. Supported: arm64 and amd64." >&2
	exit 1
	;;
esac
BINARY="$ROOT_DIR/.cache/bin/pissbox-$OS-$ARCH"
if [[ ! -f $BINARY || ! -x $BINARY ]]; then
	echo "Launcher executable missing or not executable: $BINARY. Run $ROOT_DIR/bin/build-launcher." >&2
	exit 1
fi
exec "$BINARY" "$@"
