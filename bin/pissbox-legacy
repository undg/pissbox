#!/usr/bin/env bash

set -euo pipefail

# --- Defaults ---------------------------------------------------------------
SETTINGS_FALLBACK_PROFILE=settings-co.json
PISSBOX_PI_DIR=${PISSBOX_PI_DIR:-}
PISSBOX_STATE_DIR=${PISSBOX_STATE_DIR:-}
SANDBOX_NAME=""
DELETE_DIRECTORY=""
ASSUME_YES=false
LIST_SANDBOXES=false
BRIDGE_STOP=false
IGNORE_CONFIG_WORKSPACES=false
WORKSPACES=()
PI_ARGS=()
RESOLVED_WORKSPACES=()
WORKSPACE_KEYS=()
BRIDGE_ID=""
BRIDGE_BINARY=""
BRIDGE_ENV_ARGS=()
ISOLATED_DIRECTORIES=()
PROJECT_JSON=""

# --- Help -------------------------------------------------------------------
show_help() {
	cat <<EOF
Usage: ${0##*/} [OPTIONS] [WORKSPACE ...]
       ${0##*/} -d DIR [-y]
       ${0##*/} -l

Start Pi in an SBX sandbox with sandbox-only configuration.

Options:
  -c, --continue       Continue the previous Pi session for the workspace
  -d, --delete DIR     Delete all sandboxes with DIR as a workspace
  -y, --yes            Open existing Pi without a menu; skip --delete confirmation
  -l, --ls             List sandboxes, current-directory matches first
  --bridge-stop        Stop this checkout's compatible host bridge daemon
  --name NAME          Pass an explicit sandbox name to SBX
  --ignore-config-workspaces
                       Skip configured mounts; keep CLI paths and setup
  --pissbox-pi-dir DIR  Override PISSBOX_PI_DIR (default: this checkout's pi-agent/)
  --pissbox-state-dir DIR
                       Override PISSBOX_STATE_DIR (default: this checkout's .cache/)
  -h, --help           Show this help
  --                   Treat remaining arguments as workspaces

With no workspaces, use the current directory.
The first workspace is primary; additional ones are mounted read-write.
Primary-workspace .pissbox.toml workspaces add mounts, relative to that project.
CLI workspaces stay first; duplicate directories are removed.
Reading .pissbox.toml requires tomljson and jq on the host.
Its setup commands run inside the sandbox once during creation, before Pi.
Opt-in isolated_directories keeps Linux dependencies separate from host directories.
Shared Linux caches live in PISSBOX_STATE_DIR, created if missing.
Directory flags override environment variables; relative paths use the caller's directory.
Settings profile follows the host name; unknown hosts use settings-co.json.
SBX chooses the sandbox name unless --name is provided.
If it already exists, choose Pi (default), continue, shell, delete, or quit [P/c/s/d/q].
With --yes, open Pi in the existing sandbox without prompting; existing mounts stay.
Deletion requires a separate confirmation [y/N], unless --delete uses --yes.
An optional prebuilt host bridge enables agent messaging and Herd lifecycle state.
Build it with bin/build-bridge; bridge failures never prevent launching Pi.
Deletion removes sandbox-local data and exits; mounted host files remain.
Delete requires an existing directory and errors if no sandboxes match.
Matching uses exact absolute workspace paths, not parent or child directories.
Delete and list require jq and cannot be combined with each other, --name, or workspaces.
EOF
}

# --- Argument parsing -------------------------------------------------------
while [[ $# -gt 0 ]]; do
	case $1 in
	-c | --continue)
		PI_ARGS=(-- --continue)
		shift
		;;
	-d | --delete)
		if [[ -z ${2:-} || ${2:-} == -* ]]; then
			echo "$1 requires a directory" >&2
			exit 1
		fi
		DELETE_DIRECTORY=$2
		shift 2
		;;
	--delete=*)
		DELETE_DIRECTORY=${1#*=}
		if [[ -z $DELETE_DIRECTORY ]]; then
			echo "--delete requires a directory" >&2
			exit 1
		fi
		shift
		;;
	-y | --yes)
		ASSUME_YES=true
		shift
		;;
	-l | --ls)
		LIST_SANDBOXES=true
		shift
		;;
	--bridge-stop)
		if [[ $# -ne 1 ]]; then
			echo "--bridge-stop must be used by itself" >&2
			exit 1
		fi
		BRIDGE_STOP=true
		shift
		;;
	--ignore-config-workspaces)
		IGNORE_CONFIG_WORKSPACES=true
		shift
		;;
	--name)
		if [[ -z ${2:-} || ${2:-} == -* ]]; then
			echo "--name requires a sandbox name" >&2
			exit 1
		fi
		SANDBOX_NAME=$2
		shift 2
		;;
	--name=*)
		SANDBOX_NAME=${1#*=}
		if [[ -z $SANDBOX_NAME ]]; then
			echo "--name requires a sandbox name" >&2
			exit 1
		fi
		shift
		;;
	--pissbox-pi-dir)
		if [[ -z ${2:-} || ${2:-} == -* ]]; then
			echo "--pissbox-pi-dir requires a directory" >&2
			exit 1
		fi
		PISSBOX_PI_DIR=$2
		shift 2
		;;
	--pissbox-pi-dir=*)
		PISSBOX_PI_DIR=${1#*=}
		if [[ -z $PISSBOX_PI_DIR ]]; then
			echo "--pissbox-pi-dir requires a directory" >&2
			exit 1
		fi
		shift
		;;
	--pissbox-state-dir)
		if [[ -z ${2:-} || ${2:-} == -* ]]; then
			echo "--pissbox-state-dir requires a directory" >&2
			exit 1
		fi
		PISSBOX_STATE_DIR=$2
		shift 2
		;;
	--pissbox-state-dir=*)
		PISSBOX_STATE_DIR=${1#*=}
		if [[ -z $PISSBOX_STATE_DIR ]]; then
			echo "--pissbox-state-dir requires a directory" >&2
			exit 1
		fi
		shift
		;;
	-h | --help)
		show_help
		exit 0
		;;
	--)
		shift
		WORKSPACES+=("$@")
		break
		;;
	-*)
		echo "Unknown option: $1" >&2
		echo "Use --help for usage information" >&2
		exit 1
		;;
	*)
		WORKSPACES+=("$1")
		shift
		;;
	esac
done

# --- Settings selection -----------------------------------------------------
# Unknown hosts, or hosts without a usable name, use the fallback.
settings_profile_for_host() {
	case ${1:-} in
	cm | di-7415) printf '%s\n' settings-go.json ;;
	*) printf '%s\n' "$SETTINGS_FALLBACK_PROFILE" ;;
	esac
}

detect_hostname() {
	local name
	name=$(hostname -s 2>/dev/null || true)
	if [[ -z $name ]]; then
		name=$(hostname 2>/dev/null || true)
	fi
	printf '%s\n' "$name"
}

link_settings_profile() {
	local pi_dir=$1 profile=$2 source target
	source="$pi_dir/$profile"
	target="$pi_dir/settings.json"

	if [[ ! -f $source ]]; then
		echo "Settings profile does not exist: $source" >&2
		exit 1
	fi
	if [[ -L $target ]]; then
		if [[ $(readlink "$target") == "$profile" ]]; then
			return 0
		fi
		ln -sfn "$profile" "$target"
	elif [[ -e $target ]]; then
		local backup="$target.replaced"
		if [[ -e $backup || -L $backup ]]; then
			backup="$target.replaced.$(date +%Y%m%d%H%M%S)"
		fi
		echo "Backing up existing Pi settings file: $target -> $backup" >&2
		mv "$target" "$backup"
		ln -s "$profile" "$target"
	else
		ln -s "$profile" "$target"
	fi
}

# Keep CLI spellings for SBX; compare existing directories by physical path.
append_workspace() {
	local workspace=$1 key=$1 existing
	if [[ -d $workspace ]]; then
		key=$(cd -- "$workspace" && pwd -P)
	fi
	for existing in ${WORKSPACE_KEYS[@]+"${WORKSPACE_KEYS[@]}"}; do
		if [[ $existing == "$key" ]]; then
			return 0
		fi
	done
	RESOLVED_WORKSPACES+=("$workspace")
	WORKSPACE_KEYS+=("$key")
}

# --- Terminal confirmation --------------------------------------------------
confirm() {
	local answer
	while true; do
		printf '%s ' "$1" >&2
		if ! IFS= read -r answer; then
			printf '\n' >&2
			exit 1
		fi
		case ${answer:-$2} in
		[Yy] | [Yy][Ee][Ss]) return 0 ;;
		[Nn] | [Nn][Oo]) return 1 ;;
		*) echo "Please answer yes or no." >&2 ;;
		esac
	done
}

# --- Sandbox listing and deletion -------------------------------------------
load_sandboxes() {
	local directory=$1 listing
	if ! command -v jq >/dev/null 2>&1; then
		echo "Listing and deleting sandboxes requires jq; install jq first." >&2
		exit 1
	fi
	listing=$(sbx ls --json)
	# Validate before selecting names: malformed metadata must never drive deletion.
	SANDBOXES=$(printf '%s\n' "$listing" | jq -ce --arg directory "$directory" '
		def invalid($field):
			error("Invalid sandbox metadata for \(.name | tojson): \($field); refusing to continue");
		if type != "array" then error("Expected a sandbox array")
		else map(
			if type != "object" then error("Expected a sandbox object; refusing to continue") else . end |
			# SBX reports null for a sandbox created without workspace mounts.
			if has("workspaces") and .workspaces == null then .workspaces = [] else . end |
			if (.name | type != "string") then invalid("name must be a string")
			elif (.name | test("^[A-Za-z0-9][A-Za-z0-9_.-]*$") | not) then invalid("name contains unsupported characters")
			elif (.agent | type != "string") then invalid("agent must be a string")
			elif (.status | type != "string") then invalid("status must be a string")
			elif (.workspaces | type != "array") then invalid("workspaces must be an array or explicit null")
			elif (.workspaces | all(.[]; type == "string" and startswith("/")) | not) then invalid("workspaces must contain absolute path strings")
			else . + {associated: (.workspaces | index($directory) != null)} end
		) end
	')
}

print_sandbox_header() {
	local heading="" muted="" reset=""
	if [[ -t 1 && ${TERM:-} != dumb && -z ${NO_COLOR+x} ]]; then
		heading=$'\033[1;36m'
		muted=$'\033[2m'
		reset=$'\033[0m'
	fi
	printf '%s%s%s\n' "$heading" "$1" "$reset"
	printf '%s────────────────────────────────────────%s\n' "$muted" "$reset"
	if [[ -n ${2:-} ]]; then
		printf '  %s%s%s\n' "$muted" "$2" "$reset"
	fi
}

print_sandbox_group() {
	local associated=$1
	printf '%s\n' "$SANDBOXES" | jq -r --argjson associated "$associated" '
		map(select(.associated == $associated)) |
		if length == 0 then "  (none)"
		else .[] | "  \(.name)  [\(.status)]  (\(.agent))\n    \(.workspaces | join(", "))"
		end
	'
}

# Run management operations before touching Pi settings or shared state.
if [[ -n $DELETE_DIRECTORY || $LIST_SANDBOXES == true ]]; then
	if [[ ( -n $DELETE_DIRECTORY && $LIST_SANDBOXES == true ) ||
		-n $SANDBOX_NAME || ${#WORKSPACES[@]} -ne 0 ]]; then
		echo "Delete and list cannot be combined with each other, --name, or workspaces." >&2
		exit 1
	fi
	if [[ -n $DELETE_DIRECTORY ]]; then
		if [[ ! -d $DELETE_DIRECTORY ]]; then
			echo "Directory does not exist: $DELETE_DIRECTORY" >&2
			exit 1
		fi
		DIRECTORY=$(cd "$DELETE_DIRECTORY" && pwd -P)
	else
		DIRECTORY=$(pwd -P)
	fi
	load_sandboxes "$DIRECTORY"
	if [[ $LIST_SANDBOXES == true ]]; then
		print_sandbox_header "Current directory" "$DIRECTORY"
		print_sandbox_group true
		printf '\n'
		print_sandbox_header "Other sandboxes"
		print_sandbox_group false
		exit 0
	fi

	MATCHING_NAMES=$(printf '%s\n' "$SANDBOXES" | jq -r '.[] | select(.associated) | .name')
	if [[ -z $MATCHING_NAMES ]]; then
		echo "No sandboxes associated with directory: $DIRECTORY" >&2
		exit 1
	fi
	SANDBOX_NAMES=()
	while IFS= read -r NAME; do
		SANDBOX_NAMES+=("$NAME")
	done <<< "$MATCHING_NAMES"
	printf 'Sandboxes associated with %s:\n' "$DIRECTORY" >&2
	print_sandbox_group true >&2
	echo "Deletion loses sandbox-local data. Mounted host files remain." >&2
	if [[ $ASSUME_YES == true ]] || confirm "Delete all ${#SANDBOX_NAMES[@]} matching sandboxes? [y/N]" n; then
		exec sbx rm --force "${SANDBOX_NAMES[@]}"
	fi
	exit 0
fi

# --- Launcher paths ---------------------------------------------------------
# Follow launcher symlinks without readlink -f (unavailable on older macOS).
SCRIPT_PATH=${BASH_SOURCE[0]}
while [[ -L $SCRIPT_PATH ]]; do
	SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
	SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
	if [[ $SCRIPT_PATH != /* ]]; then
		SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
	fi
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"

bridge_binary_path() {
	local os arch
	case $(uname -s) in
	Darwin) os=darwin ;;
	Linux) os=linux ;;
	*) return 1 ;;
	esac
	case $(uname -m) in
	arm64 | aarch64) arch=arm64 ;;
	x86_64 | amd64) arch=amd64 ;;
	*) return 1 ;;
	esac
	printf '%s\n' "$SCRIPT_DIR/../.cache/bin/go-bridge-$os-$arch"
}

if [[ $BRIDGE_STOP == true ]]; then
	if ! binary=$(bridge_binary_path) || [[ ! -x $binary ]]; then
		echo "Matching host bridge binary is missing or unsupported." >&2
		exit 1
	fi
	exec "$binary" stop
fi

PISSBOX_PI_DIR="${PISSBOX_PI_DIR:-"$SCRIPT_DIR/../pi-agent"}"
PISSBOX_STATE_DIR="${PISSBOX_STATE_DIR:-"$SCRIPT_DIR/../.cache"}"

# --- Project configuration and workspaces -----------------------------------
if [[ ${#WORKSPACES[@]} -eq 0 ]]; then
	WORKSPACES=("$PWD")
fi
PISSBOX_WORKSPACE_DIR=${WORKSPACES[0]}
if [[ $PISSBOX_WORKSPACE_DIR != /* ]]; then
	PISSBOX_WORKSPACE_DIR="$PWD/$PISSBOX_WORKSPACE_DIR"
fi
for WORKSPACE in "${WORKSPACES[@]}"; do
	append_workspace "$WORKSPACE"
done

PROJECT_CONFIG="$PISSBOX_WORKSPACE_DIR/.pissbox.toml"
if [[ -e $PROJECT_CONFIG || -L $PROJECT_CONFIG ]]; then
	if [[ ! -f $PROJECT_CONFIG || ! -r $PROJECT_CONFIG ]]; then
		echo "Project configuration must be a readable TOML file: $PROJECT_CONFIG" >&2
		exit 1
	fi
	for TOOL in tomljson jq; do
		if ! command -v "$TOOL" >/dev/null 2>&1; then
			echo "Reading .pissbox.toml requires $TOOL on the host; install it before launching." >&2
			exit 1
		fi
	done
	CONFIG_SCRIPT="$SCRIPT_DIR/../sbx-kit/files/home/.pissbox/scripts/project-setup.sh"
	# Read data only: setup commands are never evaluated on the host.
	PROJECT_JSON=$(bash "$CONFIG_SCRIPT" --validate "$PROJECT_CONFIG")
	if [[ $IGNORE_CONFIG_WORKSPACES == false ]]; then
		while IFS= read -r -d '' WORKSPACE; do
			if [[ $WORKSPACE != /* ]]; then
				WORKSPACE="$PISSBOX_WORKSPACE_DIR/$WORKSPACE"
			fi
			if [[ ! -d $WORKSPACE ]]; then
				echo "Configured workspace directory does not exist: $WORKSPACE" >&2
				exit 1
			fi
			WORKSPACE=$(cd -- "$WORKSPACE" && pwd -P)
			append_workspace "$WORKSPACE"
		done < <(printf '%s\n' "$PROJECT_JSON" | jq -j '.workspaces[] | ., "\u0000"')
	fi
fi

if [[ -n ${PROJECT_JSON:-} ]]; then
	while IFS= read -r -d '' DIRECTORY; do
		ISOLATED_DIRECTORIES+=("$DIRECTORY")
	done < <(printf '%s\n' "$PROJECT_JSON" | jq -j '.isolated_directories[] | ., "\u0000"')
fi
if [[ ${#ISOLATED_DIRECTORIES[@]} -gt 0 ]]; then
	source "$SCRIPT_DIR/lib/isolated-directories.sh"
	validate_isolated_paths "$PISSBOX_WORKSPACE_DIR"
fi

# --- Pi directory and settings ----------------------------------------------
if [[ ! -d $PISSBOX_PI_DIR ]]; then
	echo "Pi directory does not exist: $PISSBOX_PI_DIR" >&2
	exit 1
fi
PISSBOX_PI_DIR="$(cd "$PISSBOX_PI_DIR" && pwd -P)"
HOST_NAME=$(detect_hostname)
SETTINGS_PROFILE=$(settings_profile_for_host "$HOST_NAME")
link_settings_profile "$PISSBOX_PI_DIR" "$SETTINGS_PROFILE"

# --- Shared state -----------------------------------------------------------
mkdir -p "$PISSBOX_STATE_DIR"
PISSBOX_STATE_DIR="$(cd "$PISSBOX_STATE_DIR" && pwd -P)"

append_workspace "$PISSBOX_PI_DIR"
append_workspace "$PISSBOX_STATE_DIR"
WORKSPACES=("${RESOLVED_WORKSPACES[@]}")

# --- SBX invocation ---------------------------------------------------------
REQUESTED_SANDBOX_NAME=$SANDBOX_NAME
SBX_ARGS=(run --env "PISSBOX_PI_DIR=$PISSBOX_PI_DIR"
	--env "PISSBOX_STATE_DIR=$PISSBOX_STATE_DIR"
	--env "PISSBOX_WORKSPACE_DIR=$PISSBOX_WORKSPACE_DIR")
if [[ -n $SANDBOX_NAME ]]; then
	SBX_ARGS+=(--name "$SANDBOX_NAME")
fi

# --- Optional host bridge ---------------------------------------------------
stop_bridge() {
	if [[ -n $BRIDGE_ID ]]; then
		"$BRIDGE_BINARY" unregister --id "$BRIDGE_ID" || true
		BRIDGE_ID=""
	fi
	BRIDGE_ENV_ARGS=()
}

start_bridge() {
	local binary mailbox
	local herd_args=()
	BRIDGE_ENV_ARGS=()
	if [[ ${HERDR_ENV:-} == 1 ]]; then
		if [[ -n ${HERDR_SOCKET_PATH:-} && -n ${HERDR_PANE_ID:-} ]]; then
			herd_args=(--herdr-socket "$HERDR_SOCKET_PATH" --herdr-pane "$HERDR_PANE_ID")
		else
			echo "Warning: Herd reporting disabled; missing socket or pane environment. Agent messaging remains available." >&2
		fi
	fi
	if ! binary=$(bridge_binary_path); then
		echo "Warning: Host bridge disabled; unsupported host platform." >&2
		return 0
	fi
	if [[ ! -x $binary ]]; then
		echo "Warning: Host bridge binary missing; run bin/build-bridge. Continuing without it." >&2
		return 0
	fi
	if [[ ! -f $PISSBOX_PI_DIR/extensions/pissbox-bridge.js ||
		! -f $PISSBOX_PI_DIR/extensions/lib/agent-messaging.js ||
		! -f $PISSBOX_PI_DIR/extensions/lib/agent-identity.js ||
		! -f $PISSBOX_PI_DIR/extensions/agent-names.txt ]]; then
		echo "Warning: Host bridge extension missing from selected Pi directory. Continuing without it." >&2
		return 0
	fi
	if ! mailbox=$(mktemp -d "$PISSBOX_STATE_DIR/bridge-launch.XXXXXXXX"); then
		echo "Warning: cannot create host bridge mailbox. Continuing without it." >&2
		return 0
	fi
	BRIDGE_BINARY=$binary
	if BRIDGE_ID=$("$binary" register --mailbox "$mailbox" \
		${herd_args[@]+"${herd_args[@]}"} --owner-pid "$$" </dev/null) && [[ -n $BRIDGE_ID ]]; then
		BRIDGE_ENV_ARGS=(--env "PISSBOX_BRIDGE_DIR=$mailbox")
		return 0
	fi
	BRIDGE_ID=""
	echo "Warning: Host bridge failed to start. Continuing without it." >&2
}

trap stop_bridge EXIT
if [[ ${#ISOLATED_DIRECTORIES[@]} -gt 0 ]]; then
	prepare_isolated_creation
else
	start_bridge
fi

SBX_ARGS+=(${BRIDGE_ENV_ARGS[@]+"${BRIDGE_ENV_ARGS[@]}"}
	"$SCRIPT_DIR/../sbx-kit" "${WORKSPACES[@]}")
if [[ ${SBX_ARGS[0]} == run ]]; then
	SBX_ARGS+=(${PI_ARGS[@]+"${PI_ARGS[@]}"})
fi

# Keep stdin/stdout on the terminal and stream stderr while capturing SBX's error.
exec 3>&1
if SBX_ERROR=$(sbx "${SBX_ARGS[@]}" 2>&1 1>&3 | tee -a /dev/stderr); then
	# Do not let a bridge daemon started below inherit the saved terminal/pipe.
	exec 3>&-
	if [[ ${#ISOLATED_DIRECTORIES[@]} -gt 0 ]]; then
		finish_isolated_creation
		start_bridge
		sbx run --name "$SANDBOX_NAME" ${BRIDGE_ENV_ARGS[@]+"${BRIDGE_ENV_ARGS[@]}"} ${PI_ARGS[@]+"${PI_ARGS[@]}"}
		exit $?
	fi
	exit 0
else
	SBX_STATUS=$?
fi
exec 3>&-
stop_bridge

# --- Existing sandbox handling ----------------------------------------------
CONFLICT_PATTERN="sandbox '([^']+)' already exists and can't be given new workspaces"
CREATE_CONFLICT_PATTERN='sandbox "([A-Za-z0-9][A-Za-z0-9_.-]*)" already exists for this workspace; pass --name to create another, or start the existing sandbox'
NAMED_CREATE_CONFLICT_PATTERN="sandbox '([A-Za-z0-9][A-Za-z0-9_.-]*)' already exists; connect to the existing sandbox"
if [[ ${#ISOLATED_DIRECTORIES[@]} -gt 0 && -n $REQUESTED_SANDBOX_NAME &&
	$SBX_ERROR =~ $NAMED_CREATE_CONFLICT_PATTERN ]]; then
	SANDBOX_NAME=${BASH_REMATCH[1]}
	if [[ $SANDBOX_NAME != "$REQUESTED_SANDBOX_NAME" ]]; then
		exit "$SBX_STATUS"
	fi
elif [[ ${#ISOLATED_DIRECTORIES[@]} -gt 0 && -z $REQUESTED_SANDBOX_NAME &&
	$SBX_ERROR =~ $CREATE_CONFLICT_PATTERN ]]; then
	SANDBOX_NAME=${BASH_REMATCH[1]}
elif [[ ${#ISOLATED_DIRECTORIES[@]} -eq 0 && $SBX_ERROR =~ $CONFLICT_PATTERN ]]; then
	SANDBOX_NAME=${BASH_REMATCH[1]}
else
	exit "$SBX_STATUS"
fi

# Inline for compatibility with existing sandboxes whose kit predates isolation.
require_ready_sandbox() {
	sbx exec --user 1000 "$SANDBOX_NAME" sh -eu -c '
		if [ -n "${PISSBOX_ISOLATION_DIR:-}" ]; then
			if [ ! -f "$HOME/.pissbox/isolation-ready" ] ||
				[ "$(cat "$HOME/.pissbox/isolation-ready")" != "$PISSBOX_ISOLATION_DIR" ]; then
				echo "Isolation setup is incomplete; use a new sandbox or explicitly delete this one. Setup will not be replayed." >&2
				exit 1
			fi
		fi
	' pissbox-readiness
}

if [[ $ASSUME_YES == false ]]; then
	cat >&2 <<EOF
Sandbox '$SANDBOX_NAME' already exists.

  p) Open Pi [default]
  c) Continue previous Pi session
  s) Open shell
  d) Delete sandbox
  q) Quit

EOF
fi

while true; do
	CHOICE=p
	if [[ $ASSUME_YES == false ]]; then
		printf 'Choose [P/c/s/d/q]: ' >&2
		if ! IFS= read -rsn 1 CHOICE; then
			printf '\n' >&2
			exit 1
		fi
		printf '\n' >&2
	fi
	case ${CHOICE:-p} in
	[Pp] | [Cc])
		if [[ $CHOICE == [Cc] ]]; then
			PI_ARGS=(-- --continue)
		fi
		require_ready_sandbox
		start_bridge
		if [[ -n $BRIDGE_ID ]]; then
			sbx run --name "$SANDBOX_NAME" ${BRIDGE_ENV_ARGS[@]+"${BRIDGE_ENV_ARGS[@]}"} ${PI_ARGS[@]+"${PI_ARGS[@]}"}
			exit $?
		fi
		exec sbx run --name "$SANDBOX_NAME" ${PI_ARGS[@]+"${PI_ARGS[@]}"}
		;;
	[Ss])
		require_ready_sandbox
		exec sbx exec -it "$SANDBOX_NAME" bash
		;;
	[Dd])
		echo "Deletion loses sandbox-local data. Mounted host files remain." >&2
		if confirm "Do you want to delete it? [y/N]" n; then
			exec sbx rm --force "$SANDBOX_NAME"
		fi
		exit 0
		;;
	[Qq]) exit 0 ;;
	*) echo "Please choose p, c, s, d, or q." >&2 ;;
	esac
done
