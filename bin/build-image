#!/usr/bin/env bash

set -euo pipefail

show_help() {
	cat <<EOF
Usage: ${0##*/} [-- DOCKER_BUILD_OPTION ...]

Build pissbox:local, save its archive, and load it into SBX.
Run on the host with Docker running and the sbx CLI installed.

Options:
  -h, --help  Show this help
  --          Forward remaining arguments to docker build

Example:
  ${0##*/} -- --build-arg PI_VERSION=latest --no-cache

Uses this checkout's sbx-kit/ regardless of your working directory.
Passes sbx-kit/ca.crt as an optional public CA when present.
Use -- --no-cache when adding, changing, or removing the CA after a build.
Saves to this checkout's .cache/images/pissbox-local.tar, replacing any old archive.
Existing sandboxes are not updated or removed.
EOF
}

require_buildkit() {
	if docker buildx version >/dev/null 2>&1; then
		return
	fi
	echo "Error: the docker buildx plugin is missing; the Dockerfile requires BuildKit." >&2
	echo "Docs: https://docs.docker.com/go/buildx/" >&2
	if [[ $(uname -s) == Darwin ]]; then
		echo "macOS: Docker Desktop ships buildx, Colima and Homebrew do not. Every step here is a survival test." >&2
		echo "  brew install docker-buildx" >&2
		echo "  ln -sfn \"\$(brew --prefix)/lib/docker/cli-plugins/docker-buildx\" ~/.docker/cli-plugins/docker-buildx" >&2
	else
		echo "Install it with your package manager and rerun, for example:" >&2
		echo "sudo pacman -S docker-buildx  # Arch Linux" >&2
	fi
	exit 1
}

while [[ $# -gt 0 ]]; do
	case $1 in
	-h | --help)
		show_help
		exit 0
		;;
	--)
		shift
		break
		;;
	*)
		echo "Unexpected argument: $1. Use --help for usage." >&2
		exit 1
		;;
	esac
done

# Follow symlinks without readlink -f for macOS compatibility.
SCRIPT_PATH=${BASH_SOURCE[0]}
while [[ -L $SCRIPT_PATH ]]; do
	SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
	SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
	if [[ $SCRIPT_PATH != /* ]]; then
		SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
	fi
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd -P)"
IMAGE=pissbox:local
ARCHIVE="$ROOT_DIR/.cache/images/pissbox-local.tar"
CA_FILE="$ROOT_DIR/sbx-kit/ca.crt"
CA_ARGS=()
if [[ -f $CA_FILE ]]; then
	CA_ARGS=(--secret "id=custom_ca,src=$CA_FILE")
else
	echo "Info: $CA_FILE not found; using the base image's trust store without an additional CA." >&2
fi

for TOOL in docker sbx; do
	if ! command -v "$TOOL" >/dev/null 2>&1; then
		echo "Required command not found: $TOOL" >&2
		exit 1
	fi
done

require_buildkit

docker build -t "$IMAGE" "${CA_ARGS[@]}" "$@" "$ROOT_DIR/sbx-kit"
mkdir -p "$(dirname "$ARCHIVE")"
docker image save "$IMAGE" -o "$ARCHIVE"
exec sbx template load "$ARCHIVE"
