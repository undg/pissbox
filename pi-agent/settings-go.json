{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.5.2",
  "hideThinkingBlock": true,
  "extensions": [
    "extensions/pi-notifier/index.ts",
    "extensions/collapse-tool-output.ts",
    "extensions/tui-nice/index.ts",
    "extensions/disable-share.ts",
    "extensions/vault/index.ts"
  ],
  "packages": [
    "npm:@gotgenes/pi-colgrep"
  ],
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": false
  },
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "treeFilterMode": "all",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "steeringMode": "all",
  "followUpMode": "all",
  "enableSkillCommands": true,
  "showHardwareCursor": true,
  "transport": "sse",
  "doubleEscapeAction": "tree",
  "autocompleteMaxVisible": 20,
  "sessionShareDestination": "gist",
  "markdown": {
    "mermaid": "streaming"
  },
  "theme": "system",
  "tuiMode": "regular",
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4.1-flash",
  "defaultThinkingLevel": "max",
  "enabledModels": [
    "deepseek/deepseek-flash",
    "deepseek/deepseek-v4-pro"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:@gotgenes/pi-colgrep\",\"scope\":\"user\"}": "2.0.0"
  }
}